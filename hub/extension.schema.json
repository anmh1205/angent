{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ANGENT extension manifest v1/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "kind",
    "authority",
    "description",
    "source",
    "skills",
    "roles",
    "runtime",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^angent-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "direct",
        "mapped",
        "bridged"
      ]
    },
    "authority": {
      "const": "specialist"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "origin",
        "type",
        "license"
      ],
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "skills": {
      "type": "object",
      "required": [
        "directory",
        "expose",
        "exclude",
        "expected_source_count"
      ],
      "additionalProperties": false,
      "properties": {
        "directory": {
          "const": "skills"
        },
        "expose": {
          "const": "all"
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "expected_source_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "roles": {
      "type": "object",
      "required": [
        "directory",
        "expected_count"
      ],
      "additionalProperties": false,
      "properties": {
        "directory": {
          "const": "agents"
        },
        "expected_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "native",
        "fallback",
        "selection",
        "exclusive"
      ],
      "additionalProperties": false,
      "properties": {
        "native": {
          "type": [
            "string",
            "null"
          ]
        },
        "fallback": {
          "enum": [
            "portable",
            "none"
          ]
        },
        "selection": {
          "type": "string",
          "minLength": 1
        },
        "exclusive": {
          "type": "boolean"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "entry",
          "when"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9-]+)+$"
          },
          "entry": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "when": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry",
          "summary",
          "capabilities",
          "domains",
          "aliases",
          "invocation",
          "outputs",
          "requires"
        ],
        "properties": {
          "entry": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "invocation": {
            "enum": [
              "automatic",
              "explicit"
            ]
          },
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9-]+)+$"
            }
          },
          "domains": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "outputs": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "requires": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "methods"
        ]
      },
      "else": {
        "not": {
          "required": [
            "methods"
          ]
        }
      }
    }
  ]
}
